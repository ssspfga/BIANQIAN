{
  "name": "notes-biji",
  "version": "1.1.1",
  "private": true,
  "description": "便签 · Windows(Electron) 与 Android(Capacitor) 共用同一套界面",
  "main": "electron/main.js",
  "author": "notes",
  "scripts": {
    "start": "electron .",
    "win": "electron-builder --win portable",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.biji.notes",
    "productName": "便签",
    "directories": { "output": "dist" },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"]
    }
  }
}
